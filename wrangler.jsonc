{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proposal-review",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "web/gateway.js",
  "routes": [
    {
      "pattern": "review.ymroue.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ACCESS_ISSUER": "https://tyrus-llc.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "bf4bdcdbc03ff2cebcbd149a8e7113e51e63671e294c413d72c3456c7af0e561"
  }
}
